{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainer-hub",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trainer-hub",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Trainer names (comma-separated) that can see site change requests made through the assistant.
  "vars": { "ADMIN_TRAINERS": "" },
  "observability": { "enabled": true }
}
